# .env.example — скопировать в .env и заполнить.
# .env читается docker-compose автоматически и подставляется в ${VAR}.
# Никогда не коммитить .env с реальными секретами.

# ── PostgreSQL ────────────────────────────────────────────────────
DATABASE_USER=postgres
DATABASE_PASSWORD=08965

# ── MinIO ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=whatsmax_admin
MINIO_ROOT_PASSWORD=whatsmax_secret_change_me
# Куда клиент (Android эмулятор / браузер) обращается к MinIO.
# Эмулятор Android: http://10.0.2.2:9000. Реальное устройство в LAN: http://<ip-хоста>:9000.
MINIO_PUBLIC_ENDPOINT=http://10.0.2.2:9000

# ── CORS ──────────────────────────────────────────────────────────
# Через запятую, без протокола. Пустая строка = anyHost (только dev).
CORS_ALLOWED_HOSTS=
